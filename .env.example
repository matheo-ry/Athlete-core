# Copia este archivo como ".env.local" y rellena los valores.
# ".env.local" NO se sube a Git. Aquí solo van los NOMBRES, nunca valores reales.

# Entorno de la app: local, staging o production.
VITE_APP_ENV=local

# Supabase: OBLIGATORIAS desde la Fase 1 (DECISIONES D-025).
# En local salen de "npx supabase status" (API_URL y PUBLISHABLE_KEY).
# Solo la clave PÚBLICA (publishable / anon). La clave service_role nunca va aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: la dirección pública de la web (por ejemplo, https://app.tudominio.com).
# Con ella se montan los enlaces de invitación (/join?code=…). Si se deja vacía,
# se usa la dirección desde la que se está viendo la app.
VITE_PUBLIC_APP_URL=

# Opcional, solo para desarrollo y tests: "true" deja registrar entrenos en el
# navegador (normalmente solo se puede en la app del móvil, DECISIONES D-116).
# Se ignora en cualquier build (npm run build), así que nunca llega a la web
# publicada. Los tests de flujos completos la necesitan en "true".
VITE_ALLOW_WEB_WORKOUTS=

# ---------------------------------------------------------------------------
# Staging (PR 1.17). Para probar desde tu ordenador contra el proyecto de
# staging, crea ".env.staging.local" (tampoco se sube a Git) con las mismas
# variables y arranca con "npm run dev:staging". Sus valores mandan sobre los
# de ".env.local".
#
#   VITE_APP_ENV=staging
#   VITE_SUPABASE_URL=              <- la "Project URL" del proyecto de staging
#   VITE_SUPABASE_PUBLISHABLE_KEY=  <- su "publishable key" (es pública)
#
# La contraseña de la base de datos y la clave de Resend NO van en ningún
# archivo: solo en el panel de Supabase y en tu gestor de contraseñas.
# Guía paso a paso: supabase/README.md, "Guía: poner en marcha staging".
